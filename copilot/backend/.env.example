# Server
PORT=3004
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Security
JWT_SECRET=replace-with-a-long-random-secret

# Bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v1
BEDROCK_MAX_TOKENS=4000
BEDROCK_TEMPERATURE=0.3

# Data sources
PINECONE_API_KEY=
PINECONE_INDEX_NAME=silver
NCBI_API_KEY=

# Firebase
FIREBASE_DATABASE_URL=
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id"}

# Feature flags
ENABLE_SEMANTIC_SEARCH=true
ENABLE_VECTOR_SEARCH=true
ENABLE_FILE_LOGGING=true
ENABLE_TRIAL_REGISTRY_SYNC=true

# Trial registry (ClinicalTrials.gov + EU CTIS)
TRIAL_REGISTRY_STORE=sqlite
TRIAL_REGISTRY_SQLITE_PATH=./data/trial_registry.sqlite
TRIAL_REGISTRY_LOCATION=Portugal
TRIAL_REGISTRY_SYNC_ON_BOOT=true
TRIAL_REGISTRY_SYNC_STALE_HOURS=168
TRIAL_REGISTRY_SYNC_SCHEDULE=0 3 * * 1
TRIAL_REGISTRY_SYNC_TIMEZONE=Europe/Lisbon
TRIAL_REGISTRY_SYNC_STATUSES=RECRUITING
# CTIS (EU Clinical Trials Information System) is fetched automatically alongside ClinicalTrials.gov
# BEDROCK_TRIAL_MATCH_MODEL=anthropic.claude-sonnet-4-6-20250514

# INFARMED Reimbursement (Portugal drug access / AUE / PAP / indications)
# Syncs monthly from: AUE list, AUE benefit, PAP (Programa de Acesso Precoce),
# INFOMED authorisations, and Transparência SNS hospital spending
INFARMED_REIMBURSEMENT_ENABLED=true
INFARMED_STORE=sqlite
INFARMED_SQLITE_PATH=./data/infarmed_reimbursement.sqlite
INFARMED_SYNC_ON_BOOT=true
INFARMED_STALE_HOURS=744
INFARMED_SYNC_SCHEDULE=0 4 1 * *
INFARMED_SYNC_TIMEZONE=Europe/Lisbon
INFARMED_LLM_EXTRACTION=true
INFARMED_INCLUDE_INFOMED=true
INFARMED_INCLUDE_PAP=true
INFARMED_INCLUDE_TRANSPARENCIA=true
# INFARMED_INFOMED_DELAY_MS=1500
# BEDROCK_INFARMED_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
