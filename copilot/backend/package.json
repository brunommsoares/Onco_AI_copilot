{
  "name": "oncology-evidence-platform",
  "version": "2.0.0",
  "description": "Professional oncology evidence synthesis and clinical decision support platform",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test tests/runtimeEnv.test.js tests/appHealth.test.mjs tests/authMiddleware.test.mjs tests/evidenceSelectionService.test.mjs tests/pdfProcessingService.test.mjs tests/simpleChatEngineSelector.test.mjs tests/simpleChatService.test.mjs tests/trialRegistryService.test.mjs tests/simpleChatRoute.trialRegistry.test.mjs",
    "test:config": "node --test tests/runtimeEnv.test.js",
    "test:watch": "node --test --watch tests/runtimeEnv.test.js tests/appHealth.test.mjs tests/authMiddleware.test.mjs tests/evidenceSelectionService.test.mjs tests/pdfProcessingService.test.mjs tests/simpleChatEngineSelector.test.mjs tests/simpleChatService.test.mjs tests/trialRegistryService.test.mjs tests/simpleChatRoute.trialRegistry.test.mjs",
    "regression:simple-chat": "node scripts/runSimpleChatRegression.mjs",
    "trial-registry:sync": "node scripts/runTrialRegistrySync.mjs",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "build": "npm run lint && npm run test",
    "docker:build": "docker build -t oncology-platform .",
    "docker:run": "docker run -p 3002:3002 oncology-platform"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.1014.0",
    "@aws-sdk/client-bedrock-runtime": "^3.500.0",
    "@pinecone-database/pinecone": "^6.0.1",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.4.3",
    "canvas": "^3.2.2",
    "cheerio": "^1.0.0-rc.12",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "docx": "^8.5.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.0.1",
    "express-validator": "^7.0.1",
    "fast-xml-parser": "^5.2.5",
    "firebase-admin": "^13.4.0",
    "groq-sdk": "^1.1.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "joi": "^17.11.0",
    "jsdom": "^27.0.0",
    "jsonwebtoken": "^9.0.2",
    "markdown-it": "^14.1.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "officeparser": "^6.0.4",
    "openai": "^6.32.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^5.5.207",
    "pg": "^8.11.5",
    "puppeteer": "^21.5.2",
    "redis": "^5.8.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "tesseract.js": "^7.0.0",
    "winston": "^3.11.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.1.0",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "oncology",
    "evidence-based-medicine",
    "clinical-decision-support",
    "medical-ai",
    "healthcare"
  ],
  "author": "Oncology Evidence Platform Team",
  "license": "MIT"
}
