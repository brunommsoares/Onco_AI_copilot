# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION ENVIRONMENT VARIABLES
# Copy this file to .env and fill in all values before deploying.
# NEVER commit the filled .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# Server
NODE_ENV=production
PORT=3004
JWT_SECRET=change-this-to-a-long-random-string-min-32-chars

# Allowed origins (comma-separated) — your production domain(s)
ALLOWED_ORIGINS=https://yourdomain.com

# ── AWS Bedrock (REQUIRED) ────────────────────────────────────────────────────
# Use IAM user credentials (NOT bearer tokens — those are temporary)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# Models
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_FALLBACK_MODEL_ID=amazon.nova-pro-v1:0
BEDROCK_MAX_TOKENS=5000
BEDROCK_TEMPERATURE=0.1

# ── PubMed (Recommended) ─────────────────────────────────────────────────────
# Without a key requests are rate-limited to 3/s. Get one free at:
# https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=

# ── Firebase Authentication (Optional) ───────────────────────────────────────
# Paste the entire content of firebase-service-account.json as a single JSON string.
# On Render/Railway set this as an environment variable in the dashboard.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# ── Pinecone Vector Search (Optional) ────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_HOST=

# ── Trial Registry ───────────────────────────────────────────────────────────
TRIAL_REGISTRY_STORE=sqlite
TRIAL_REGISTRY_SQLITE_PATH=/var/data/trial_registry.sqlite
TRIAL_REGISTRY_LOCATION=Portugal
TRIAL_REGISTRY_SYNC_ON_BOOT=true
TRIAL_REGISTRY_SYNC_STALE_HOURS=168
TRIAL_REGISTRY_SYNC_SCHEDULE=0 3 * * 1
TRIAL_REGISTRY_SYNC_TIMEZONE=Europe/Lisbon
TRIAL_REGISTRY_SYNC_STATUSES=RECRUITING

# ── Feature Flags ────────────────────────────────────────────────────────────
ENABLE_PUBMED=true
ENABLE_TRIAL_REGISTRY_SYNC=true
